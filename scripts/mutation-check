#!/usr/bin/env python3
"""Prove the suite's assertions catch what they claim: swap kali_pentest_server.py
for the version at <base-rev>, run the suite against it, and require a genuine
ASSERTION FAILURE.

Reads unittest's STRUCTURED result (testsRun / failures / errors), never the
runner's text. `FAILED (errors=1)` and `FAILED (failures=1)` are different facts
and `grep '^FAILED ('` cannot tell them apart: an import error in the mutated
source prints the first one and would otherwise be accepted as proof. Exit
status alone is no better - an unimportable module, a missing dependency and a
runner that collected nothing all exit non-zero while asserting nothing.

The counts arrive on a private pipe, never on stdout or stderr. Collected tests
print to both - the launcher test emits a docker command line - so a verdict
sharing either channel is the same text-parsing hazard in another coat.

Clears __pycache__ around every swap. A restore that rewrites the same byte
count inside one second reproduces the source mtime, so Python keeps running the
MUTATED bytecode while the source reads clean.

Exit: 0 the mutation was caught, 1 the suite passed against it, 2 inconclusive,
3 nothing to measure (the base and the working tree carry the same file, so no
mutation was introduced and the assertions were never put to the question).
"""
import json
import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

CAUGHT, SUITE_PASSED, INCONCLUSIVE, NOTHING_TO_MEASURE = 0, 1, 2, 3
TARGET = "kali_pentest_server.py"

# Run in a child process so a mutated import cannot contaminate this one, and
# report counts as JSON down a private pipe (fd number in argv[2]) while
# unittest's text and any output a test makes go to the terminal.
RUNNER = r'''
import json, os, sys, unittest
suite = unittest.defaultTestLoader.discover("tests", pattern=sys.argv[1])
result = unittest.TextTestRunner(verbosity=1, stream=sys.stderr).run(suite)
os.write(int(sys.argv[2]), json.dumps({"testsRun": result.testsRun,
                                       "failures": len(result.failures),
                                       "errors": len(result.errors)}).encode())
'''


def verdict(tests_run, failures, errors, base="the mutated source"):
    """The whole decision, taken on counts. Returns (exit_code, message).

    Proof requires all three: tests were collected, at least one ASSERTION
    failed, and nothing errored. An error is broken infrastructure, and broken
    infrastructure proves nothing about the assertions.
    """
    if tests_run <= 0:
        return INCONCLUSIVE, (
            f"MUTATION CHECK INCONCLUSIVE: collected {tests_run} tests against {base}. "
            "Nothing was asserted, so nothing was proved.")
    if errors:
        return INCONCLUSIVE, (
            f"MUTATION CHECK INCONCLUSIVE: {errors} ERROR(s) against {base} "
            f"({failures} assertion failure(s), {tests_run} tests run). An error is "
            "broken infrastructure, not evidence the assertions pin anything.")
    if not failures:
        return SUITE_PASSED, (
            f"MUTATION CHECK FAILED: {tests_run} tests ran clean against {base}, "
            "so the assertions pin nothing.")
    return CAUGHT, (
        f"mutation check OK: {tests_run} tests ran against {base}, {failures} failed "
        "on assertions, 0 errors.")


def clear_cache(repo):
    for cache in repo.rglob("__pycache__"):
        shutil.rmtree(cache, ignore_errors=True)


def run_suite(pattern, cwd=None, stdout=None, stderr=None):
    """Run the suite in a child and read its counts off a private pipe.

    Returns (child exit status, counts dict or None). The payload travels on an
    inherited pipe, not stdout: a collected test is free to print anything at
    all, valid JSON included, and it lands on the terminal where it cannot be
    mistaken for the verdict. Nothing but this pipe reaches the read end, so
    there is no file to leak either.

    stdout/stderr default to None, which inherits this process's - the child's
    output belongs on the terminal. The self-test points them elsewhere so its
    deliberate noise stays out of the parent suite's log, where a stray
    `FAILED (failures=1)` would read as a real failure.
    """
    read_fd, write_fd = os.pipe()
    # Never read to EOF: any process the child forked inherits the write end and
    # can hold the pipe open past the child's exit, and a blocking read would
    # then hang the gate instead of failing it. The child writes its counts
    # before it exits, so once run() has reaped it the payload is already in the
    # buffer; a non-blocking read either finds it or leaves raw empty, which is
    # the INCONCLUSIVE verdict below.
    os.set_blocking(read_fd, False)
    try:
        try:
            run = subprocess.run([sys.executable, "-c", RUNNER, pattern, str(write_fd)],
                                 pass_fds=(write_fd,), cwd=cwd, stdout=stdout, stderr=stderr)
        finally:
            os.close(write_fd)
        try:
            raw = os.read(read_fd, 65536)
        except BlockingIOError:
            raw = b""
    finally:
        os.close(read_fd)
    try:
        return run.returncode, json.loads(raw)
    except ValueError:
        return run.returncode, None


def main(argv):
    if len(argv) < 2:
        print(f"usage: {argv[0]} <base-rev> [test-pattern]", file=sys.stderr)
        return INCONCLUSIVE
    base = argv[1]
    pattern = argv[2] if len(argv) > 2 else "test_scanner_adapters.py"

    repo = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())
    os.chdir(repo)
    target = repo / TARGET

    if subprocess.run(["git", "diff", "--quiet", "HEAD", "--", TARGET]).returncode:
        print(f"refusing to run: {TARGET} has uncommitted changes", file=sys.stderr)
        return INCONCLUSIVE

    mutated = subprocess.run(["git", "show", f"{base}:{TARGET}"], capture_output=True)
    if mutated.returncode:
        print(f"refusing to run: cannot read {base}:{TARGET}", file=sys.stderr)
        sys.stderr.buffer.write(mutated.stderr)
        return INCONCLUSIVE

    # Held in memory, so there is no temp file to leak when we are interrupted.
    original = target.read_bytes()

    # No mutation, so the assertions were never put to the question. Saying they
    # "pin nothing" here would accuse them of failing a test they never sat.
    if mutated.stdout == original:
        print(f"MUTATION CHECK: NOTHING TO MEASURE: {TARGET} at {base} is byte-identical "
              "to the working tree, so no mutation was introduced.", file=sys.stderr)
        return NOTHING_TO_MEASURE

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(INCONCLUSIVE))
    try:
        target.write_bytes(mutated.stdout)
        clear_cache(repo)
        status, counts = run_suite(pattern)
    finally:
        target.write_bytes(original)
        clear_cache(repo)

    if counts is None:
        print(f"MUTATION CHECK INCONCLUSIVE: the runner exited {status} without a "
              "structured result, so no verdict is possible.", file=sys.stderr)
        return INCONCLUSIVE

    code, message = verdict(counts["testsRun"], counts["failures"], counts["errors"], base)
    print(message, file=sys.stdout if code == CAUGHT else sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
